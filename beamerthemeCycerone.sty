% ---------- Beamer base ----------
\mode<presentation>{
	\usetheme{default}
	\useinnertheme{default}
	\useoutertheme{default}
	\setbeamertemplate{navigation symbols}{}
	\setbeamertemplate{headline}{}
}

\setbeamercolor{normal text}{fg=cyText,bg=cyCream}
\setbeamercolor{structure}{fg=cyDark}
\setbeamercolor{itemize item}{fg=cyDark}
\setbeamercolor{itemize subitem}{fg=cyDark}
% Tune ordinary-frame left/right margins here.
\setbeamersize{text margin left=9mm,text margin right=9mm}
\setbeamerfont{title}{size=\fontsize{38}{43}\selectfont,series=\mdseries}
\setbeamerfont{frametitle}{size=\fontsize{30}{35}\selectfont,series=\mdseries}
\setbeamerfont{normal text}{size=\fontsize{16}{20}\selectfont}
\setbeamertemplate{itemize item}{\raise0.25ex\hbox{\tiny$\bullet$}}
\setbeamertemplate{itemize subitem}{\raise0.20ex\hbox{\tiny$\bullet$}}

% ---------- Blocks and inline code ----------
\setbeamercolor{block title}{fg=white,bg=cyBlock}
\setbeamercolor{block body}{fg=white,bg=cyBlock}
\setbeamercolor{block title alerted}{fg=cyText,bg=cyAlertBlock}
\setbeamercolor{block body alerted}{fg=cyText,bg=cyAlertBlock}
\setbeamerfont{block title}{series=\bfseries}
\setbeamerfont{block title alerted}{series=\bfseries}
\defbeamertemplate{block begin}{cycerone}{%
	\begin{beamercolorbox}[wd=\textwidth,rounded=true,shadow=false,sep=1.2ex]{block body}%
		{\usebeamerfont{block title}\usebeamercolor[fg]{block title}\insertblocktitle\par}\vspace{0.45ex}%
		\usebeamerfont{block body}\usebeamercolor[fg]{block body}%
		}
		\defbeamertemplate{block end}{cycerone}{\end{beamercolorbox}}
\defbeamertemplate{block alerted begin}{cycerone}{%
	\begin{beamercolorbox}[wd=\textwidth,rounded=true,shadow=false,sep=1.2ex]{block body alerted}%
		{\usebeamerfont{block title alerted}\usebeamercolor[fg]{block title alerted}\insertblocktitle\par}\vspace{0.45ex}%
		\usebeamerfont{block body alerted}\usebeamercolor[fg]{block body alerted}%
		}
		\defbeamertemplate{block alerted end}{cycerone}{\end{beamercolorbox}}
\setbeamertemplate{block begin}[cycerone]
\setbeamertemplate{block end}[cycerone]
\setbeamertemplate{block alerted begin}[cycerone]
\setbeamertemplate{block alerted end}[cycerone]
\renewcommand{\texttt}[1]{{\setlength{\fboxsep}{1.2pt}\colorbox{cyInlineCode}{\strut\color{cyText}\ttfamily #1}}}

% ---------- Helpers ----------
\newcommand{\cyLogoPlaceholder}[2]{%
	\begin{tikzpicture}[baseline=(x.base)]
		\node[draw=#1, rounded corners=1.5pt, inner xsep=3mm, inner ysep=2mm,
			minimum width=22mm, minimum height=10mm, align=center, text=#1,
			font=\normalfont\scriptsize] (x) {#2};
	\end{tikzpicture}%
}

\newcommand{\cyProjectLogoDark}[1][16mm]{%
	\IfFileExists{\cyProjectLogoDarkFile}{\includegraphics[height=#1]{\cyProjectLogoDarkFile}}{\cyLogoPlaceholder{cyDark}{PROJECT\\LOGO}}%
}
\newcommand{\cyProjectLogoLight}[1][16mm]{%
	\IfFileExists{\cyProjectLogoLightFile}{\includegraphics[height=#1]{\cyProjectLogoLightFile}}{\cyLogoPlaceholder{cyCream}{PROJECT\\LOGO}}%
}
\newcommand{\cyProjectLogo}[1][16mm]{%
	\cyProjectLogoDark[#1]%
}
\newcommand{\cyEULogo}[1][10mm]{%
	\IfFileExists{\cyEULogoFile}{\includegraphics[height=#1]{\cyEULogoFile}}{\cyLogoPlaceholder{blue!70!black}{EU\\LOGO}}%
}
\newcommand{\cyTitleGraphic}[1][11mm]{%
	\IfFileExists{\cyTitleGraphicFile}{\includegraphics[width=#1,height=#1,keepaspectratio]{\cyTitleGraphicFile}}{}%
}

% Tune the top-right logo inset and height here.
\newcommand{\cyTopLogoDark}{%
