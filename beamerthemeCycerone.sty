	\end{tikzpicture}%
}

\newcommand{\cyLogoBanner}{%
	\begin{tikzpicture}[remember picture,overlay]
		\node[anchor=north west, fill=cyCream, rounded corners=3pt, minimum width=55mm, minimum height=18mm,
			inner xsep=4mm] at ([xshift=8mm,yshift=-7mm]current page.north west) {\cyProjectLogoDark[14mm]\hspace{12mm}\cyEULogo[10mm]};
	\end{tikzpicture}%
}

\newcommand{\cyAgendaStoreSection}[1]{}
\newcommand{\cyAgendaAddSection}[1]{}

\newcommand{\cyAgendaPage}[1][]{%
	\cyCircuitBackgroundDark\cyTopLogoDark\cyHeaderTag{Agenda}%
	\begin{tikzpicture}[remember picture,overlay]
		\node[anchor=west, text=cyMutedMint, align=left, font=\normalfont\fontsize{23}{28}\selectfont] at ([xshift=9mm,yshift=-4mm]current page.west) {Today's\\AGENDA};
		\node[anchor=north west, text=cyCream, align=left] at ([xshift=52mm,yshift=-27mm]current page.north west) {%
			\begin{minipage}[t]{70mm}
				\setbeamertemplate{section in toc}{%
					\vspace{1.2mm}%
					\parbox[t]{\linewidth}{%
						\raggedright
						\fontsize{13}{15}\selectfont
						\textcolor{cyMint}{\ifnum\inserttocsectionnumber<10 0\fi\inserttocsectionnumber}%%
						\hspace{0.9em}\textcolor{cyCream}{\inserttocsection}
					}%
				}%
				\setbeamertemplate{subsection in toc}{}
				\setbeamertemplate{section in toc shaded}{%
					\vspace{1.2mm}%
					\parbox[t]{\linewidth}{%
						\raggedright
						\fontsize{13}{15}\selectfont
						\textcolor{cyCream}{\inserttocsection}
					}%
				}%
				\if\relax\detokenize{#1}\relax
					\tableofcontents[hideallsubsections]
				\else
					\cyAgendaList{#1}
				\fi
			\end{minipage}%;
		};
	\end{tikzpicture}%
}

\NewDocumentCommand{\cySectionPage}{ O{30} m m m O{60mm} O{40mm} }{
	\cyCircuitBackgroundDark\cyTopLogoDark
	\begin{tikzpicture}[remember picture,overlay]
		\sbox0{\parbox[t]{0.86\paperwidth}{\raggedright\fontsize{#1pt}{\dimexpr#1pt+4pt\relax}\selectfont #3}}%
		\newdimen\cySectionTitleHeight
		\cySectionTitleHeight=\dimexpr\ht0+\dp0\relax
		\newdimen\cySectionTitleShift
		\cySectionTitleShift=0pt
		\ifdim\cySectionTitleHeight>26mm
			\cySectionTitleShift=\dimexpr\cySectionTitleHeight-26mm\relax
		\fi
		\edef\cySectionNumberYShift{\the\dimexpr#5-\cySectionTitleShift\relax}
		\edef\cySectionTitleYShift{\the\dimexpr#6-\cySectionTitleShift\relax}
		\node[anchor=west, text=cyMutedMint, align=left, font=\normalfont\fontsize{41}{45}\selectfont] at ([xshift=9mm,yshift=\cySectionNumberYShift]current page.south west) {#2};
		\node[anchor=west, text=cyCream, align=left] at ([xshift=9mm,yshift=\cySectionTitleYShift]current page.south west) {\parbox[t]{0.86\paperwidth}{\raggedright\fontsize{#1pt}{\dimexpr#1pt+4pt\relax}\selectfont #3}};
		\if\relax\detokenize{#4}\relax\else
			\node[anchor=south east, text=cyMint, align=right] at ([xshift=-13mm,yshift=17mm]current page.south east) {\parbox[t]{0.48\paperwidth}{\raggedright\fontsize{8}{10}\selectfont #4}};
		\fi
	\end{tikzpicture}%
}

