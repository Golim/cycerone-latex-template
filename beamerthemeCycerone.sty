		\node[anchor=west, text=cyCream, font=\normalfont\fontsize{55}{61}\selectfont] at ([xshift=9mm,yshift=8mm]current page.west) {Thank You!};
		% Tune the contact block position with the yshifts below.
		\node[anchor=west, text=cyCream, align=left, font=\normalfont\fontsize{23}{28}\selectfont] at ([xshift=9mm,yshift=27mm]current page.south west) {GET IN TOUCH\\WITH US};
		\node[anchor=west, text=cyMint, font=\normalfont\fontsize{8}{9}\selectfont] at ([xshift=33mm,yshift=15mm]current page.south west) {\cyWebsite};
		\node[anchor=west, text=cyCream, align=left, font=\normalfont\fontsize{8}{11}\selectfont] at ([xshift=69mm,yshift=27mm]current page.south west) {\rule{25mm}{1.2mm}\\\cyContactName\\\href{mailto:\cyContactEmail}{\cyContactEmail}\\\href{\cyContactWebsite}{\cyContactWebsite}\\\href{\cyLinkedInURL}{LinkedIn}\\\href{\cyYouTubeURL}{YouTube}};
	\end{tikzpicture}%
}

% ---------- Frame commands ----------
\newcommand{\cyTitleFrame}[3][]{%
	{\setbeamercolor{background canvas}{bg=cyDark}%
			\begin{frame}[plain]
				\begin{tikzpicture}[remember picture,overlay]
					\fill[cyDark] (current page.south west) rectangle ([xshift=-80mm]current page.north east);
					\fill[cyCream] ([xshift=-80mm]current page.south east) rectangle (current page.north east);
					\cyCirclesArtwork
				\end{tikzpicture}
				\cyTitleLogoBanner
				\begin{tikzpicture}[remember picture,overlay]
					\node[anchor=west, text=cyMint, font=\normalfont\fontsize{7}{8}\selectfont] at ([xshift=9mm,yshift=-40mm]current page.north west) {\MakeUppercase{\cyEventName}};
					\node[anchor=north west, text=cyCream, align=left, text width=72mm, font=\normalfont\fontsize{17}{20}\selectfont] at ([xshift=9mm,yshift=-28mm]current page.north west) {\parbox[t]{72mm}{#2}};
					\node[anchor=west, text=cyMutedMint, font=\normalfont\fontsize{8}{9}\selectfont] at ([xshift=9mm,yshift=12mm]current page.south west) {#3};
					\IfFileExists{#1}{%
						\node[anchor=south east, circle, fill=white, draw=white, minimum size=18mm, inner sep=1.8mm]
						at ([xshift=-10mm,yshift=10mm]current page.south east) {\includegraphics[width=11mm,height=11mm,keepaspectratio]{#1}};
					}{%
						\node[anchor=south east, circle, fill=white, draw=white, minimum size=18mm, inner sep=1.8mm]
						at ([xshift=-10mm,yshift=10mm]current page.south east) {\cyLogoPlaceholder{cyDark}{#1}};
					}%
				\end{tikzpicture}
			\end{frame}}
}

\newcommand{\cyAgendaFrame}[1]{%
	{\setbeamercolor{background canvas}{bg=cyDark}%
			\begin{frame}[plain]
				\cyAgendaPage{#1}
			\end{frame}}
}

\newcounter{cyagendaitem}
\newcommand{\cyAgendaList}[1]{%
	\setcounter{cyagendaitem}{0}%
	\renewcommand*{\do}[1]{%
		\stepcounter{cyagendaitem}%
		\noindent\begin{tabular*}{70mm}{@{}p{48mm}@{\extracolsep{\fill}}r@{}}
			{\fontsize{22}{26}\selectfont ##1} & {\fontsize{28}{31}\selectfont\color{cyMint}\ifnum\value{cyagendaitem}<10 0\fi\arabic{cyagendaitem}}
		\end{tabular*}\par\vspace{2mm}{\color{cyLine}\rule{70mm}{0.3pt}}\par\vspace{2mm}%
	}\docsvlist{#1}%
}

\newcommand{\cySectionFrame}[3]{%
	{\setbeamercolor{background canvas}{bg=cyDark}%
			\begin{frame}[plain]
				\cySectionPage{#1}{#2}{#3}
			\end{frame}}
}

\newcommand{\cyPlainFrame}[3][]{%
	{\setbeamercolor{background canvas}{bg=cyCream}%
			\begin{frame}[plain]
				\cyCircuitBackgroundLight\cyTopLogoLight\cyHeaderTag{#1}
				\begin{tikzpicture}[remember picture,overlay]
					\node[anchor=north west, text=cyText, align=left, font=\normalfont\fontsize{31}{36}\selectfont] at ([xshift=9mm,yshift=-29mm]current page.north west) {#2};
					\node[anchor=north west, text=cyText, align=left] at ([xshift=10mm,yshift=-61mm]current page.north west) {\begin{minipage}{100mm}#3\end{minipage}};
				\end{tikzpicture}
			\end{frame}}
}

\newcommand{\cyImageFrame}[4][]{%
	{\setbeamercolor{background canvas}{bg=cyCream}%
			\begin{frame}[plain]
				\cyCircuitBackgroundLight\cyTopLogoLight\cyHeaderTag{#1}
				\begin{tikzpicture}[remember picture,overlay]
					\node[anchor=north west, text=cyText, align=left, font=\normalfont\fontsize{29}{34}\selectfont] at ([xshift=9mm,yshift=-29mm]current page.north west) {#2};
					\node[anchor=north west, text=cyText, align=left] at ([xshift=10mm,yshift=-61mm]current page.north west) {\begin{minipage}{52mm}#3\end{minipage}};
					\node[anchor=north east, rounded corners=5pt, fill=black!10, minimum width=57mm, minimum height=56mm, text=cyMutedMint, align=center]
					at ([xshift=-8mm,yshift=-28mm]current page.north east)
					{\IfFileExists{#4}{\includegraphics[width=57mm,height=56mm,keepaspectratio]{#4}}{\Large image\\placeholder}};
				\end{tikzpicture}
			\end{frame}}
}

\newcommand{\cyThanksFrame}{%
	{\setbeamercolor{background canvas}{bg=cyDark}%
			\begin{frame}[plain]
				\cyThanksPage
			\end{frame}}
}

% ---------- Ordinary frames ----------
\defbeamertemplate*{footline}{cycerone}{%
	\ifnum\value{framenumber}>1\relax
		\leavevmode\hbox{\begin{beamercolorbox}[wd=\paperwidth,ht=4mm,dp=1.5mm,leftskip=9mm,rightskip=9mm]{author in head/foot}%
				\usebeamerfont{author in head/foot}\color{cyMutedMint}\fontsize{7}{8}\selectfont\insertauthor\hfill\insertsectionhead%
			\end{beamercolorbox}}%
	\fi
}
\setbeamertemplate{footline}[cycerone]

\defbeamertemplate*{frametitle}{cycerone}{%
	\cyTopLogoLight%
	% Tune title/content vertical spacing with these two values.
	\vspace{-1.5mm}{\parbox[t]{\dimexpr\paperwidth-18mm\relax}{\raggedright\normalfont\fontsize{24}{28}\selectfont\color{cyText}\insertframetitle}}\par\vspace{0.5mm}%
}
\setbeamertemplate{frametitle}[cycerone]

\setbeamertemplate{title page}{%
	\begin{tikzpicture}[remember picture,overlay]
		\fill[cyDark] (current page.south west) rectangle ([xshift=-80mm]current page.north east);
		\fill[cyCream] ([xshift=-80mm]current page.south east) rectangle (current page.north east);
		\cyCirclesArtwork
	\end{tikzpicture}%
	\cyTitleLogoBanner
	\begin{tikzpicture}[remember picture,overlay]
		\node[anchor=west, text=cyMint, font=\normalfont\fontsize{7}{8}\selectfont] at ([xshift=9mm,yshift=-40mm]current page.north west) {\MakeUppercase{\cyEventName}};
		\node[anchor=north west, text=cyCream, align=left, font=\normalfont\fontsize{17}{20}\selectfont, inner sep=0pt] at ([xshift=9mm,yshift=-56mm]current page.north west) {\shortstack[l]{\inserttitle}};
		\node[anchor=west, text=cyMutedMint, font=\normalfont\fontsize{8}{9}\selectfont] at ([xshift=9mm,yshift=18mm]current page.south west) {\insertauthor};
		\node[anchor=west, text=cyMutedMint, font=\normalfont\fontsize{8}{9}\selectfont] at ([xshift=9mm,yshift=10mm]current page.south west) {\insertdate};
		\node[anchor=south east, circle, fill=white, draw=white, minimum size=18mm, inner sep=1.8mm]
		at ([xshift=-86mm,yshift=6mm]current page.south east) {\cyTitleGraphic};
	\end{tikzpicture}%
}
