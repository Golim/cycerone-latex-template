	\end{tikzpicture}%
}
\newcommand{\cyTopLogoLight}{%
	\begin{tikzpicture}[remember picture,overlay]
		\node[anchor=north east] at ([xshift=-1.5mm,yshift=-1.5mm]current page.north east) {\cyProjectLogoDark[14mm]};
	\end{tikzpicture}%
}

\newcommand{\cyCirclesArtwork}{%
